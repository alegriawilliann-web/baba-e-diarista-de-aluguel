# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# NUNCA compartilhe ou commite o arquivo ".env" de verdade.

# Access Token (chave PRIVADA) do Mercado Pago — Painel > Suas integrações > sua aplicação > Credenciais de produção
MP_ACCESS_TOKEN=

# Public Key (chave PÚBLICA) do Mercado Pago — mesma tela, usada pelo app para tokenizar o cartão
MP_PUBLIC_KEY=

# String de conexão do Postgres. No Render, ao criar um banco Postgres e
# conectar a este serviço, essa variável é preenchida automaticamente.
# Localmente, aponte para um Postgres na sua máquina, ex:
DATABASE_URL=postgres://usuario:senha@localhost:5432/baba_pagamentos

PORT=3000
