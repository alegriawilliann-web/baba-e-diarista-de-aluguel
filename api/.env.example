# Copie para ".env" e preencha. NUNCA commite o ".env" de verdade.

# String de conexão do Neon (Postgres serverless) — pegue em neon.tech > seu projeto > Connection string
DATABASE_URL=postgres://usuario:senha@ep-xxxx.neon.tech/babadealuguel?sslmode=require

# Gere uma string aleatória longa (ex: `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PORT=3000
NODE_ENV=development

# Origens permitidas separadas por vírgula. Em dev pode deixar "*".
CORS_ORIGIN=*

# Mercado Pago — Painel > Suas integrações > sua aplicação > Credenciais de TESTE (por enquanto)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

DEFAULT_COUNTRY_CODE=BR
DEFAULT_CURRENCY=BRL

APP_BASE_URL=http://localhost:3000
